# Allows running `docker compose` commands from the repository root.
# Compose uses docker/ as project directory (directory of the first compose file),
# so docker/.env is loaded and all relative paths resolve as if run from docker/.
# Note: when passing `--env-file`, this file is not loaded, so also pass the compose file,
# e.g. `docker compose -f docker/compose.yaml --env-file docker/.env --env-file docker/.env-custom up -d`
COMPOSE_FILE=docker/compose.yaml
